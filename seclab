#!/usr/bin/env bash
# seclab: start, stop and inspect the lab projects, and run the portal.
#
# Layout: <ROOT>/portal/seclab (this file) and <ROOT>/<project>/run.sh.
# Runtime files (pid and log per project) live in <ROOT>/.run/.
set -u

SELF="$(readlink -f "${BASH_SOURCE[0]}")"
PORTAL_DIR="$(dirname "$SELF")"
ROOT="$(dirname "$PORTAL_DIR")"
RUN_DIR="$ROOT/.run"
PORTAL_PORT=8100
PROJECTS=(malware-lab threat-intel honeypot-net ics-sim ai-ids)

declare -A PORTS=(
  [malware-lab]=8101
  [threat-intel]=8102
  [honeypot-net]=8103
  [ics-sim]=8104
  [ai-ids]=8105
)

usage() {
  cat <<EOF
usage: seclab <command> [name]

  up [--no-update]   start the whole stack: portal + all five labs (pulls latest first)
  down               stop the whole stack: all five labs + portal
  update             git pull --ff-only every repo (also runs automatically on 'up')
  start <name|all>   start a project in the background (runs its ./run.sh)
  stop <name|all>    stop a project (SIGTERM, then SIGKILL after 5 s)
  status             show port, pid, running state and health of each project
  portal             run the portal on 127.0.0.1:$PORTAL_PORT (foreground)
  tui [--once]       terminal view of all projects (starts the portal in the background if needed)
  logs <name>        follow a project's log (Ctrl+C to quit)
  pipeline [--once|--watch [S]|--status] [--malware-host NAME]
                     bridge the labs: honeypot/malware -> threat-intel -> ai-ids, ics-sim -> ai-ids
  demo               start the labs one at a time, seed them, run the pipeline once, stop them

projects: ${PROJECTS[*]}
EOF
  exit "${1:-1}"
}

die() {
  echo "seclab: $*" >&2
  exit 1
}

is_project() {
  local p
  for p in "${PROJECTS[@]}"; do
    [[ $p == "$1" ]] && return 0
  done
  return 1
}

# Sets TARGETS to every project for "all", or to the single named project.
resolve_targets() {
  if [[ $1 == all ]]; then
    TARGETS=("${PROJECTS[@]}")
  elif is_project "$1"; then
    TARGETS=("$1")
  else
    die "unknown project '$1' (known: ${PROJECTS[*]}, all)"
  fi
}

pid_file() { echo "$RUN_DIR/$1.pid"; }
log_file() { echo "$RUN_DIR/$1.log"; }

# The pid recorded at start time, or nothing.
recorded_pid() {
  local f
  f="$(pid_file "$1")"
  [[ -f $f ]] && cat "$f"
  return 0
}

# A project counts as running while its process group exists.
group_alive() {
  [[ -n $1 ]] && kill -0 -- "-$1" 2>/dev/null
}

is_running() {
  group_alive "$(recorded_pid "$1")"
}

start_one() {
  local name=$1
  local dir="$ROOT/$name"
  local script="$dir/run.sh"
  local log pid i

  if [[ ! -d $dir ]]; then
    echo "$name: project directory not found: $dir" >&2
    return 1
  fi
  if [[ ! -f $script ]]; then
    echo "$name: run.sh not found in $dir" >&2
    return 1
  fi
  if [[ ! -x $script ]]; then
    echo "$name: run.sh is not executable (chmod +x $script)" >&2
    return 1
  fi
  if is_running "$name"; then
    echo "$name: already running (pid $(recorded_pid "$name")), skipping"
    return 0
  fi

  mkdir -p "$RUN_DIR"
  log="$(log_file "$name")"
  # setsid gives run.sh its own session and process group, so stop can signal the whole tree.
  (cd "$dir" && exec setsid nohup ./run.sh >>"$log" 2>&1 </dev/null) &
  pid=$!
  echo "$pid" >"$(pid_file "$name")"

  sleep 1
  if ! group_alive "$pid"; then
    rm -f "$(pid_file "$name")"
    echo "$name: exited right after start, last log lines:" >&2
    tail -n 5 "$log" >&2 2>/dev/null
    return 1
  fi
  echo "$name: started (pid $pid, port ${PORTS[$name]}), log $log"
}

stop_one() {
  local name=$1
  local pid i
  pid="$(recorded_pid "$name")"

  if ! group_alive "$pid"; then
    rm -f "$(pid_file "$name")"
    echo "$name: not running"
    return 0
  fi

  kill -TERM -- "-$pid" 2>/dev/null
  for ((i = 0; i < 50; i++)); do
    group_alive "$pid" || break
    sleep 0.1
  done
  if group_alive "$pid"; then
    kill -KILL -- "-$pid" 2>/dev/null
    echo "$name: still alive after SIGTERM, sent SIGKILL"
  fi
  rm -f "$(pid_file "$name")"
  echo "$name: stopped (pid $pid)"
}

show_status() {
  local name port pid running body health
  printf '%-14s %-6s %-8s %-8s %s\n' NAME PORT PID RUNNING HEALTH
  for name in "${PROJECTS[@]}"; do
    port="${PORTS[$name]}"
    if is_running "$name"; then
      running=yes
      pid="$(recorded_pid "$name")"
    else
      running=no
      pid="-"
    fi
    body="$(curl -s -m 2 "http://127.0.0.1:$port/api/health")"
    if [[ -z $body ]]; then
      health="no response"
    else
      health="$(grep -o '"status" *: *"[^"]*"' <<<"$body" | head -n 1 | sed 's/.*"\([^"]*\)"$/\1/')"
      health="${health:-bad response}"
    fi
    printf '%-14s %-6s %-8s %-8s %s\n' "$name" "$port" "$pid" "$running" "$health"
  done
}

# Pull the latest code for the portal and every lab repo. Fast-forward only, so it
# never merges, never rebases and never discards local work; it refuses cleanly if a
# repo has diverged. Never prompts (GIT_TERMINAL_PROMPT=0) and times out, so a slow or
# offline network can't hang startup. Repos with uncommitted changes are left alone.
update_repos() {
  command -v git >/dev/null 2>&1 || return 0
  echo "checking for updates (git pull --ff-only)..."
  local entry name dir before after out
  for entry in "portal|$PORTAL_DIR"; do
    name="${entry%%|*}"; dir="${entry#*|}"; _update_one "$name" "$dir"
  done
  for name in "${PROJECTS[@]}"; do _update_one "$name" "$ROOT/$name"; done
}
_update_one() {
  local name="$1" dir="$2" before after out
  [[ -d "$dir/.git" ]] || return 0
  if [[ -n "$(git -C "$dir" status --porcelain 2>/dev/null)" ]]; then
    echo "  $name: local changes, left as-is"; return 0
  fi
  before="$(git -C "$dir" rev-parse --short HEAD 2>/dev/null)"
  out="$(GIT_TERMINAL_PROMPT=0 timeout 25 git -C "$dir" pull --ff-only --quiet 2>&1)"
  if [[ $? -ne 0 ]]; then
    echo "  $name: skipped (${out%%$'\n'*})"; return 0
  fi
  after="$(git -C "$dir" rev-parse --short HEAD 2>/dev/null)"
  if [[ "$before" != "$after" ]]; then
    echo "  $name: updated $before -> $after"
  else
    echo "  $name: up to date"
  fi
}

cmd="${1:-}"
[[ $# -gt 0 ]] && shift

case "$cmd" in
  start|stop)
    [[ $# -ge 1 ]] || usage
    resolve_targets "$1"
    rc=0
    for name in "${TARGETS[@]}"; do
      if [[ $cmd == start ]]; then
        start_one "$name" || rc=1
      else
        stop_one "$name"
      fi
    done
    exit "$rc"
    ;;
  status)
    show_status
    ;;
  update)
    update_repos
    ;;
  up)
    # Manual "start the whole stack": portal (web screen) + all five labs. Never runs at login.
    command -v python3 >/dev/null || die "python3 not found"
    mkdir -p "$RUN_DIR"
    [[ ${1:-} == --no-update || ${SECLAB_NO_UPDATE:-} == 1 ]] || update_repos
    if curl -s -m 1 -o /dev/null "http://127.0.0.1:$PORTAL_PORT/"; then
      echo "portal: already up on 127.0.0.1:$PORTAL_PORT"
    else
      (umask 077; setsid nohup python3 "$PORTAL_DIR/server.py" >>"$RUN_DIR/portal.log" 2>&1 </dev/null &)
      for _ in $(seq 1 20); do curl -s -m 1 -o /dev/null "http://127.0.0.1:$PORTAL_PORT/" && break; sleep 0.25; done
      echo "portal: started on 127.0.0.1:$PORTAL_PORT"
    fi
    resolve_targets all
    for name in "${TARGETS[@]}"; do start_one "$name"; done
    echo "open http://127.0.0.1:$PORTAL_PORT in your browser"
    ;;
  down)
    # Manual "stop the whole stack": all five labs + the portal.
    resolve_targets all
    for name in "${TARGETS[@]}"; do stop_one "$name"; done
    pid="$(ss -ltnpH "sport = :$PORTAL_PORT" 2>/dev/null | grep -oP 'pid=\K[0-9]+' | head -1)"
    if [[ -n $pid ]]; then kill "$pid" 2>/dev/null && echo "portal: stopped (pid $pid)"; else echo "portal: not running"; fi
    ;;
  portal)
    command -v python3 >/dev/null || die "python3 not found"
    if curl -s -m 1 -o /dev/null "http://127.0.0.1:$PORTAL_PORT/"; then
      die "something is already answering on 127.0.0.1:$PORTAL_PORT"
    fi
    exec python3 "$PORTAL_DIR/server.py"
    ;;
  tui)
    if ! curl -s -m 1 -o /dev/null "http://127.0.0.1:$PORTAL_PORT/"; then
      mkdir -p "$RUN_DIR"
      (umask 077; setsid nohup python3 "$PORTAL_DIR/server.py" >>"$RUN_DIR/portal.log" 2>&1 </dev/null &)
      for _ in $(seq 1 20); do curl -s -m 1 -o /dev/null "http://127.0.0.1:$PORTAL_PORT/" && break; sleep 0.25; done
    fi
    exec python3 "$PORTAL_DIR/tui.py" "$@"
    ;;
  pipeline)
    command -v python3 >/dev/null || die "python3 not found"
    cd "$PORTAL_DIR" && exec nice -n 10 python3 -m pipeline "$@"
    ;;
  demo)
    command -v python3 >/dev/null || die "python3 not found"
    # The demo seeds and trains, so it runs under the CPU lock shared by every lab
    # project (one heavy job at a time on this laptop) and at the lowest priority.
    if [[ -z ${SECLAB_CPU_LOCK_HELD:-} ]] && command -v flock >/dev/null; then
      lock="${XDG_RUNTIME_DIR:-/tmp}/seclab-cpu.lock"
      echo "seclab: waiting for the CPU lock ($lock)"
      # -o: the lab servers started by the demo must not inherit (and keep) the lock.
      exec flock -o "$lock" env SECLAB_CPU_LOCK_HELD=1 "$SELF" demo "$@"
    fi
    cd "$PORTAL_DIR" && exec nice -n 19 env OMP_NUM_THREADS=2 OPENBLAS_NUM_THREADS=2 python3 -m pipeline.demo "$@"
    ;;
  logs)
    [[ $# -ge 1 ]] || usage
    is_project "$1" || die "unknown project '$1' (known: ${PROJECTS[*]})"
    log="$(log_file "$1")"
    [[ -f $log ]] || die "no log yet for $1 ($log)"
    exec tail -n 100 -f "$log"
    ;;
  -h|--help|help)
    usage 0
    ;;
  "")
    usage
    ;;
  *)
    echo "seclab: unknown command '$cmd'" >&2
    usage
    ;;
esac
